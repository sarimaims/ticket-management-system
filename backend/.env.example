NODE_ENV=development
PORT=5000
# Comma separated. Any https://*.devtunnels.ms origin is allowed as well.
CORS_ORIGIN=http://localhost:3000
# Every account email must be on this domain. Set NEXT_PUBLIC_EMAIL_DOMAIN to the same on the app.
EMAIL_DOMAIN=flowdesk.ae
# true when the API is on another site than the page (a dev tunnel): the
# session cookie then needs SameSite=None; Secure. Leave empty otherwise.
CROSS_SITE_COOKIES=
# Used by both Mongoose and Prisma (prisma/schema.prisma reads this variable).
MONGODB_URI=mongodb://127.0.0.1:27017/flowdesk_tickets
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Chat attachments -------------------------------------------------------
# Photos and voice notes are uploaded by the browser straight to S3 with a
# presigned URL; the API only signs and records the key. Leave S3_BUCKET empty
# and the feature reports itself unavailable instead of half working.
S3_BUCKET=
S3_REGION=
# Optional on EC2/ECS/Lambda: the instance role is used when these are blank.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for MinIO or another S3-compatible service.
S3_ENDPOINT=
# Only when the bucket is genuinely public, e.g. behind a CDN. Otherwise every
# read is a short-lived signed URL and the bucket stays private.
S3_PUBLIC_BASE_URL=
# Folder inside the bucket, so one bucket can serve several apps.
S3_PREFIX=upload/
